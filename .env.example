# Keep API local/private; no external API keys required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=embeddinggemma
RAG_STATE_DIR=./state
RAG_COLLECTION=legal_passages
RAG_RERANK=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_CANDIDATES=20
RAG_FINAL_K=4

# Experimental single re-check after model refusal or citation-contract failure.
# Off by default. Compare against a frozen benchmark before enabling in production.
RAG_RETRY_ON_FAILURE=false
